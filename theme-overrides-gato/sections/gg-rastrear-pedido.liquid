{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--gg-bg);
    min-height: 60vh;
  }
{% endstyle %}

{% render 'gg-track123-page',
  titulo: section.settings.titulo,
  subtitulo: section.settings.subtitulo
%}

{% schema %}
{
  "name": "GG – Rastrear pedido",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Rastrea tu pedido" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Ingresa tu número de guía o de pedido y el correo con el que compraste. Te mostramos el estado en Track123." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [
    { "name": "GG – Rastrear pedido" }
  ]
}
{% endschema %}
