{% doc %}
Renders AliExpress reviews imported for the GameSir G7 SE into the Gato reviews slot.
@param {object} product - Product currently shown in the reviews section
@example
{% render 'gg-aliexpress-reviews', product: product %}
{% enddoc %}

{%- liquid
  assign gg_show = false
  if product == blank
    assign gg_show = true
  endif
  if product.handle == 'control-gamesir-g7se-cable-joysticks-hall-xbox-pc'
    assign gg_show = true
  endif
  if product.handle == 'mando-gamesir-g7se-efecto-hall-xbox-pc-android'
    assign gg_show = true
  endif
-%}
