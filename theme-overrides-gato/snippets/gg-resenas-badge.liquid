{% doc %}
Shows a product rating badge that links to the customer reviews section.
@param {object} product - The product whose reviews should be summarized
@example
{% render 'gg-resenas-badge', product: product %}
{% enddoc %}

{%- if product == blank -%}
  <a class="gg-resenas-badge" href="#gg-resenas" aria-label="{{ 'gg.reviews.be_first' | t }}">
    <span class="gg-resenas-badge__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <span class="gg-resenas-badge__star">{% render 'gg-icon', name: 'star' %}</span>
      {%- endfor -%}
    </span>
    <span class="gg-resenas-badge__meta">{{ 'gg.reviews.be_first' | t }}</span>
  </a>
{%- else -%}
{%- liquid
  assign gg_rating = product.metafields.reviews.rating.value.rating
  assign gg_scale = product.metafields.reviews.rating.value.scale_max | default: 5
  assign gg_count = product.metafields.reviews.rating_count | default: 0
  if gg_rating == blank and product.metafields.judgeme.rating != blank
    assign gg_rating = product.metafields.judgeme.rating
  endif
  if gg_count == 0 or gg_count == blank
    if product.metafields.judgeme.rating_count != blank
      assign gg_count = product.metafields.judgeme.rating_count
    endif
  endif
  assign gg_full = 0
  if gg_rating != blank
    assign gg_full = gg_rating | floor
  endif
-%}
<a class="gg-resenas-badge" href="#gg-resenas" {% if gg_rating != blank and gg_count != blank and gg_count != 0 %}aria-label="{{ gg_rating }} de {{ gg_scale }}. {{ gg_count }} reseñas"{% else %}aria-label="{{ 'gg.reviews.be_first' | t }}"{% endif %}>
  {%- if gg_rating != blank and gg_count != blank and gg_count != 0 -%}
    <span class="gg-resenas-badge__stars" aria-hidden="true">
      {%- for i in (1..gg_scale) -%}
        <span class="gg-resenas-badge__star{% if i <= gg_full %} is-on{% endif %}">{% render 'gg-icon', name: 'star' %}</span>
      {%- endfor -%}
    </span>
    <span class="gg-resenas-badge__meta">
      <strong>{{ gg_rating }}</strong>
      <span>
        {%- if gg_count == 1 -%}
          {{ 'gg.reviews.count_one' | t }}
        {%- else -%}
          {{ 'gg.reviews.count_other' | t: count: gg_count }}
        {%- endif -%}
      </span>
    </span>
  {%- else -%}
    <span class="gg-resenas-badge__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <span class="gg-resenas-badge__star">{% render 'gg-icon', name: 'star' %}</span>
      {%- endfor -%}
    </span>
    <span class="gg-resenas-badge__meta">{{ 'gg.reviews.be_first' | t }}</span>
  {%- endif -%}
</a>
{%- endif -%}
