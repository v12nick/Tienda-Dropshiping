{%- assign product = section.settings.product -%}
<section class="cp-spot" id="cp-spot-{{ section.id }}">
  <div class="cp-spot__frame">
    <div class="cp-spot__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'cp-spot__photo', loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <img class="cp-spot__photo" src="{{ 'cp-angle-kit.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1024" height="1024" loading="lazy">
      {%- endif -%}
    </div>
    <div class="cp-spot__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="cp-kicker cp-kicker--ink">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cp-head__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="cp-spot__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if product != blank -%}
        <p class="cp-spot__price">
          {%- if product.compare_at_price > product.price -%}
            <s>{{ product.compare_at_price | money }}</s>
          {%- endif -%}
          <strong>{{ product.price | money }}</strong>
        </p>
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button class="cp-btn" type="submit" name="add">{{ section.settings.cta_label }}</button>
        {% endform %}
      {%- elsif section.settings.cta_url != blank -%}
        <a class="cp-btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.cp-spot {
  max-width: 1240px;
  margin: 0 auto;
  padding: 28px 16px 48px;
}
.cp-spot__frame {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 28px;
  align-items: center;
  background: linear-gradient(180deg, #f4f9fd 0%, #ffffff 100%);
  border-radius: 32px;
  padding: 18px;
}
.cp-spot__media {
  border-radius: 24px;
  overflow: hidden;
  aspect-ratio: 1;
  background: #eaf3fb;
}
.cp-spot__photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.cp-spot__copy { padding: 12px 18px 12px 8px; }
.cp-spot__text {
  margin: 10px 0 18px;
  color: #46607a;
  line-height: 1.55;
  max-width: 38ch;
}
.cp-spot__price {
  display: flex;
  gap: 10px;
  align-items: baseline;
  margin: 0 0 16px;
  color: #0b1f33;
  font-size: 1.35rem;
}
.cp-spot__price s {
  color: #8aa0b5;
  font-size: 1rem;
}
@media (max-width: 749px) {
  .cp-spot__frame { grid-template-columns: 1fr; padding: 12px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "CP Spotlight",
  "tag": "section",
  "class": "cp-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto (sin texto)" },
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Listo para enviar" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "8 cabezales. Una herramienta." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Motor de 360°, 3 velocidades y batería USB. Stock limitado." },
    { "type": "text", "id": "cta_label", "label": "Boton", "default": "Agregar al carrito" },
    { "type": "url", "id": "cta_url", "label": "Enlace si no hay producto" }
  ],
  "presets": [{ "name": "CP Spotlight", "category": "CleanPro" }]
}
{% endschema %}
