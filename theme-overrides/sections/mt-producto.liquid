{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .mt-producto-galeria-principal { aspect-ratio: 1/1; }
{% endstyle %}

{%- liquid
  assign featured_ok = nil
  assign gallery_count = 0
-%}

<section class="mt-section" id="mt-producto">
  <div class="mt-container">
    <div class="mt-producto">
      <div class="mt-producto-galeria mt-reveal">
        <div class="mt-producto-galeria-principal">
          {%- for media in product.media -%}
            {%- assign src = media.preview_image.src | default: '' -%}
            {%- if src contains '05-disenado' or src contains '06-escaparate' or src contains '07-velocidad' or src contains '08-pereza' or src contains '09-pesada' or src contains '02-save-time' -%}
              {%- continue -%}
            {%- endif -%}
            {%- if featured_ok == nil and media.media_type == 'image' -%}
              {%- assign featured_ok = media -%}
              <img id="mt-imagen-principal" src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | default: product.title | escape }}" loading="eager" fetchpriority="high">
            {%- endif -%}
          {%- endfor -%}
          {%- if featured_ok == nil -%}
            {%- if product.featured_media -%}
              <img id="mt-imagen-principal" src="{{ product.featured_media | image_url: width: 1600 }}" alt="{{ product.featured_media.alt | escape }}" loading="eager" fetchpriority="high">
            {%- else -%}
              <img id="mt-imagen-principal" src="{{ 'mt-hero.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="eager">
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="mt-producto-miniaturas">
          {%- for media in product.media -%}
            {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
            {%- assign src = media.preview_image.src | default: '' -%}
            {%- if src contains '05-disenado' or src contains '06-escaparate' or src contains '07-velocidad' or src contains '08-pereza' or src contains '09-pesada' or src contains '02-save-time' -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign gallery_count = gallery_count | plus: 1 -%}
            <button type="button" class="mt-producto-miniatura {% if gallery_count == 1 %}mt-activa{% endif %}" data-mt-thumb data-src="{{ media | image_url: width: 1600 }}">
              <img src="{{ media | image_url: width: 240 }}" alt="{{ media.alt | escape }}" loading="lazy" width="80" height="80">
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="mt-producto-compra mt-reveal">
        {%- if section.settings.mostrar_badge and section.settings.badge_texto != blank -%}
          <span class="mt-eyebrow">{{ section.settings.badge_texto }}</span>
        {%- endif -%}
        <h1 class="mt-producto-titulo">{{ section.settings.titulo_h1 | default: product.title }}</h1>
        {%- if section.settings.resenas_texto != blank -%}
          <p class="mt-producto-nota mt-producto-social">
            <span class="mt-resena-estrellas" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24"><path d="M12 3.2 14.7 9l6.3.7-4.7 4.3 1.3 6.2L12 17.3 6.4 20.2 7.7 14 3 9.7 9.3 9z"/></svg>
              {%- endfor -%}
            </span>
            <span class="mt-resena-sello">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              Compra verificada
            </span>
            <a href="#mt-resenas">{{ section.settings.resenas_texto }}</a>
          </p>
        {%- endif -%}

        <div class="mt-producto-precio">
          <span class="mt-precio-actual" data-mt-precio-actual style="font-size:32px;">{{ product.selected_or_first_available_variant.price | money }}</span>
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span class="mt-precio-antes" data-mt-precio-antes style="font-size:18px;">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
            <span class="mt-precio-badge">Precio de lanzamiento</span>
          {%- endif -%}
        </div>

        {%- form 'product', product, data-mt-producto-form: true, id: 'mt-product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-mt-variant-id>
          <div class="mt-qty" aria-label="Cantidad">
            <button type="button" data-mt-qty="-1" aria-label="Disminuir">−</button>
            <input type="number" name="quantity" id="mt-qty-input" value="1" min="1" inputmode="numeric">
            <button type="button" data-mt-qty="1" aria-label="Aumentar">+</button>
          </div>
          <button type="submit" name="add" class="mt-btn mt-btn-primario" style="width:100%;margin-top:12px;"
            data-mt-add
            data-texto-disponible="{{ section.settings.boton_texto | default: 'Pedir el mío' }}"
            data-texto-agotado="{{ section.settings.boton_agotado_texto | default: 'Agotado' }}"
            {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
            {%- if product.selected_or_first_available_variant.available == false -%}
              {{ section.settings.boton_agotado_texto | default: 'Agotado' }}
            {%- else -%}
              {{ section.settings.boton_texto | default: 'Pedir el mío' }} — {{ product.selected_or_first_available_variant.price | money }}
            {%- endif -%}
          </button>
          {{ form | payment_button }}
        {%- endform -%}

        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="mt-pagos">
            <span>Pagas al checkout con</span>
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag }}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <p class="mt-producto-micro">El envío se calcula al pagar, según tu ciudad. <a href="/pages/contact#mt-envios">Ver plazos</a>.</p>

        <ul class="mt-producto-confianza">
          <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1 0-4h12v4"/><path d="M4 6v12a2 2 0 0 0 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg><a href="/pages/contact#mt-envios">{{ section.settings.confianza_1 }}</a></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.5 0 4.8 1 6.4 2.6"/><polyline points="21 3 21 9 15 9"/></svg><a href="/pages/contact#mt-devoluciones">{{ section.settings.confianza_2 }}</a></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>{{ section.settings.confianza_3 }}</li>
        </ul>
      </div>
    </div>

    <div class="mt-producto-detalle mt-reveal">
      <h2 class="mt-h2" style="font-size:28px;">{{ section.settings.detalle_titulo }}</h2>
      <div class="mt-producto-caracteristicas">
        {%- for block in section.blocks -%}
          {%- if block.type == 'caracteristica' -%}
            <div class="mt-producto-caracteristica" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.titulo }}</h3>
              <p>{{ block.settings.texto }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.incluye_texto != blank -%}
        <div class="mt-producto-incluye">
          <h3>{{ section.settings.incluye_titulo }}</h3>
          <ul>
            {%- assign items = section.settings.incluye_texto | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- if item != blank -%}<li>{{ item }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="mt-tabla-wrap">
        <h3>Cabezal y superficie</h3>
        <table class="mt-tabla">
          <thead><tr><th>Cabezal</th><th>Para qué</th></tr></thead>
          <tbody>
            <tr><td>Cerdas redondas</td><td>Bañeras, lavamanos y curvas</td></tr>
            <tr><td>Cepillo plano</td><td>Azulejos, suelos y paredes</td></tr>
            <tr><td>Cepillo de esquinas</td><td>Juntas, rines y rincones</td></tr>
            <tr><td>Almohadillas suaves</td><td>Vidrio, estufa y superficies delicadas</td></tr>
          </tbody>
        </table>
      </div>

      <div class="mt-tabla-wrap">
        <h3>Ficha técnica</h3>
        <table class="mt-tabla">
          <tbody>
            <tr><td>Velocidades</td><td>3 modos, hasta 450 RPM</td></tr>
            <tr><td>Rotación</td><td>360°</td></tr>
            <tr><td>Mango</td><td>Telescópico hasta 130 cm</td></tr>
            <tr><td>Resistencia al agua</td><td>IPX7</td></tr>
            <tr><td>Energía</td><td>Batería recargable por USB (no uses carga rápida)</td></tr>
            <tr><td>Panel</td><td>Cuerpo blanco, panel negro con LEDs de batería</td></tr>
          </tbody>
        </table>
      </div>

      <p class="mt-aviso"><strong>Importante:</strong> no uses cargadores de carga rápida. Carga solo con el cable USB incluido.</p>
      <div class="mt-producto-descripcion mt-body">{{ product.description }}</div>
    </div>
  </div>
</section>

{%- if product.selected_or_first_available_variant.available -%}
  <div class="mt-sticky-atc" id="mt-sticky-atc" hidden>
    <span>{{ product.title }} · {{ product.selected_or_first_available_variant.price | money }}</span>
    <button type="submit" form="mt-product-form" class="mt-btn mt-btn-primario">{{ section.settings.boton_texto | default: 'Pedir el mío' }}</button>
  </div>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{% if featured_ok %}{{ featured_ok | image_url: width: 1200 | prepend: 'https:' | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% endif %}],
  "description": {{ product.description | strip_html | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>

{% style %}
  .mt-producto{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:flex-start; }
  .mt-producto-galeria-principal{ border-radius:var(--mt-radio); overflow:hidden; box-shadow:var(--mt-sombra-chica); background:var(--mt-color-fondo-alt); }
  .mt-producto-galeria-principal img{ width:100%; height:100%; object-fit:contain; background:#f2f6fc; }
  .mt-producto-miniaturas{ display:flex; gap:10px; margin-top:14px; overflow-x:auto; padding-bottom:6px; -webkit-overflow-scrolling:touch; scrollbar-width:thin; }
  .mt-producto-miniatura{ flex:none; width:76px; height:76px; border-radius:12px; overflow:hidden; border:2px solid transparent; padding:0; cursor:pointer; background:#f2f6fc; }
  .mt-producto-miniatura.mt-activa{ border-color:var(--mt-color-acento); }
  .mt-producto-miniatura img{ width:100%; height:100%; object-fit:cover; display:block; }
  .mt-producto-titulo{ font-family:var(--mt-fuente-titular); font-size:clamp(1.5rem, 2.4vw, 2rem); font-weight:700; letter-spacing:-.02em; margin:6px 0 10px; }
  .mt-producto-nota{ margin:0 0 16px; color:var(--mt-color-texto-suave); font-size:14px; }
  .mt-producto-social{ display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; }
  .mt-producto-social .mt-resena-estrellas{ margin:0; }
  .mt-producto-social a{ color:inherit; }
  .mt-producto-precio{ display:flex; align-items:baseline; gap:12px; margin-bottom:18px; flex-wrap:wrap; }
  .mt-producto-precio .mt-precio-actual{ font-family:var(--mt-fuente-titular); font-weight:700; }
  .mt-precio-badge{ background:#e8f1ff; color:var(--mt-color-acento); font-size:12px; font-weight:700; padding:4px 10px; border-radius:999px; }
  .mt-qty{ display:inline-flex; align-items:center; border:1.5px solid rgba(11,15,25,.14); border-radius:14px; overflow:hidden; }
  .mt-qty button{ width:44px; height:44px; border:0; background:#fff; font-size:20px; cursor:pointer; }
  .mt-qty input{ width:56px; height:44px; border:0; text-align:center; font:inherit; }
  .mt-pagos{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:14px; color:var(--mt-color-texto-suave); font-size:13px; }
  .mt-pagos svg, .mt-pagos img{ height:24px; width:auto; }
  .mt-producto-micro{ margin:10px 0 0; font-size:13px; color:var(--mt-color-texto-suave); }
  .mt-producto-confianza{ list-style:none; margin:22px 0 0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .mt-producto-confianza li{ display:flex; align-items:center; gap:10px; font-size:14px; color:var(--mt-color-texto-suave); }
  .mt-producto-confianza a{ color:inherit; }
  .mt-producto-confianza svg{ width:20px; height:20px; stroke:var(--mt-color-acento); flex:none; }
  .mt-producto-detalle{ margin-top:90px; max-width:820px; }
  .mt-producto-caracteristicas{ display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin:28px 0; }
  .mt-producto-caracteristica{ background:var(--mt-color-fondo-alt); border-radius:16px; padding:22px; }
  .mt-producto-caracteristica h3{ font-family:var(--mt-fuente-titular); font-size:17px; margin:0 0 6px; }
  .mt-producto-caracteristica p{ font-size:14.5px; color:var(--mt-color-texto-suave); margin:0; line-height:1.55; }
  .mt-producto-incluye{ margin:32px 0; }
  .mt-producto-incluye h3, .mt-tabla-wrap h3{ font-family:var(--mt-fuente-titular); font-size:19px; margin:0 0 12px; }
  .mt-producto-incluye ul{ margin:0; padding-left:20px; color:var(--mt-color-texto-suave); line-height:1.8; }
  .mt-tabla-wrap{ margin:28px 0; }
  .mt-tabla{ width:100%; border-collapse:collapse; font-size:14.5px; }
  .mt-tabla th, .mt-tabla td{ text-align:left; padding:12px 14px; border-bottom:1px solid rgba(11,15,25,.08); }
  .mt-tabla th{ font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--mt-color-texto-suave); }
  .mt-aviso{ background:#fff6e8; border-radius:14px; padding:14px 16px; font-size:14px; }
  .mt-producto-descripcion{ margin-top:24px; }
  .shopify-payment-button{ margin-top:10px; }
  .mt-sticky-atc{ position:fixed; left:0; right:0; bottom:0; z-index:40; display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 16px calc(12px + env(safe-area-inset-bottom)); background:#fff; box-shadow:0 -8px 30px rgba(10,20,50,.12); }
  .mt-sticky-atc span{ font-size:13px; color:var(--mt-color-texto-suave); max-width:50%; }
  .mt-sticky-atc .mt-btn{ padding:12px 18px; font-size:14px; }
  @media (min-width:901px){ .mt-sticky-atc{ display:none !important; } }
  @media (max-width:900px){
    .mt-producto{ grid-template-columns:1fr; gap:28px; }
    .mt-producto-caracteristicas{ grid-template-columns:1fr; }
    .mt-producto-detalle{ margin-top:56px; }
    body{ padding-bottom:88px; }
  }
{% endstyle %}

<script>
document.addEventListener('DOMContentLoaded', function(){
  var principal = document.getElementById('mt-imagen-principal');
  document.querySelectorAll('[data-mt-thumb]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (!principal) return;
      principal.src = btn.dataset.src;
      document.querySelectorAll('[data-mt-thumb]').forEach(function(b){ b.classList.remove('mt-activa'); });
      btn.classList.add('mt-activa');
    });
  });
  var qty = document.getElementById('mt-qty-input');
  document.querySelectorAll('[data-mt-qty]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (!qty) return;
      var next = Math.max(1, (parseInt(qty.value, 10) || 1) + parseInt(btn.getAttribute('data-mt-qty'), 10));
      qty.value = next;
    });
  });
  var sticky = document.getElementById('mt-sticky-atc');
  var form = document.getElementById('mt-product-form');
  if (sticky && form && window.matchMedia('(max-width: 900px)').matches) {
    var io = new IntersectionObserver(function(entries){
      sticky.hidden = entries[0].isIntersecting;
    }, { threshold: 0.15 });
    io.observe(form);
  }
});
</script>

{% schema %}
{
  "name": "MT – Página de producto",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "mostrar_badge", "label": "Mostrar insignia superior", "default": true },
    { "type": "text", "id": "badge_texto", "label": "Texto de la insignia", "default": "Nuevo en Colombia" },
    { "type": "text", "id": "titulo_h1", "label": "Título H1 (vacío = título del producto)", "default": "Cepillo eléctrico 8 en 1: limpia azulejos, cocina y llantas sin agacharte" },
    { "type": "text", "id": "resenas_texto", "label": "Nota bajo el título", "default": "Marta, Javier, Lucía y Diego ya lo usan en casa. Ver reseñas." },
    { "type": "text", "id": "boton_texto", "label": "Texto botón disponible", "default": "Pedir el mío" },
    { "type": "text", "id": "boton_agotado_texto", "label": "Texto botón agotado", "default": "Agotado" },
    { "type": "text", "id": "confianza_1", "label": "Confianza 1", "default": "Envío a Colombia — plazos según ciudad" },
    { "type": "text", "id": "confianza_2", "label": "Confianza 2", "default": "Retracto 5 días · fallas hasta 30 días" },
    { "type": "text", "id": "confianza_3", "label": "Confianza 3", "default": "Pago cifrado en el checkout de Shopify" },
    { "type": "text", "id": "detalle_titulo", "label": "Título de la sección de detalles", "default": "Diseñado para limpiar mejor" },
    { "type": "text", "id": "incluye_titulo", "label": "Título de \"qué incluye\"", "default": "Qué incluye tu pedido" },
    { "type": "textarea", "id": "incluye_texto", "label": "Qué incluye (un ítem por línea)", "default": "1 cepillo eléctrico giratorio CleanPro360\n8 cabezales de limpieza intercambiables\n1 cable de carga USB" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "caracteristica",
      "name": "Característica",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Rotación 360°" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Elimina grasa y suciedad incrustada con un movimiento giratorio continuo." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Página de producto",
      "blocks": [
        { "type": "caracteristica", "settings": { "titulo": "Rotación 360°", "texto": "Elimina grasa y suciedad incrustada con un movimiento giratorio continuo, sin esfuerzo manual." } },
        { "type": "caracteristica", "settings": { "titulo": "Mango extensible 130 cm", "texto": "Llega a techos de ducha y rincones altos sin subirte a nada." } },
        { "type": "caracteristica", "settings": { "titulo": "IPX7 resistente al agua", "texto": "Diseñado para usarse con seguridad en zonas húmedas, incluida la ducha." } },
        { "type": "caracteristica", "settings": { "titulo": "Batería recargable USB", "texto": "Carga con el cable incluido. No uses cargadores de carga rápida." } }
      ]
    }
  ]
}
{% endschema %}
