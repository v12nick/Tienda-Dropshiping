{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
{% endstyle %}

<section class="mt-section">
  <div class="mt-container">
    <div class="mt-uso-intro mt-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="mt-h2" style="font-size:{{ section.settings.titulo_size }}px;">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}
        <p class="mt-body">{{ section.settings.texto }}</p>
      {%- endif -%}
    </div>
    <div class="mt-uso-grid mt-stagger">
      {%- for block in section.blocks -%}
        <article class="mt-uso-card mt-reveal" style="--mt-i:{{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.imagen != blank -%}
            <img src="{{ block.settings.imagen | image_url: width: 800 }}" alt="{{ block.settings.titulo | default: block.settings.texto | escape }}" loading="lazy">
          {%- else -%}
            <img src="{{ block.settings.imagen_defecto | asset_url }}" alt="{{ block.settings.titulo | default: block.settings.texto | escape }}" loading="lazy">
          {%- endif -%}
          <div class="mt-uso-card-copy">
            {%- if block.settings.titulo != blank -%}<h3>{{ block.settings.titulo }}</h3>{%- endif -%}
            <p>{{ block.settings.texto }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.boton_texto != blank -%}
      <div class="mt-uso-cta mt-reveal">
        <a href="{{ section.settings.boton_url | default: '#' }}" class="mt-btn mt-btn-primario">{{ section.settings.boton_texto }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MT – Uso en casa",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "En cualquier rincón de la casa" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "De la cocina al baño, sin cambiar de herramienta" },
    { "type": "range", "id": "titulo_size", "label": "Tamaño del título (px)", "min": 22, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Un solo cepillo para fregaderos, encimeras, azulejos, bañeras y hasta las llantas del coche." },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Ver todos los usos" },
    { "type": "url", "id": "boton_url", "label": "Enlace del botón" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#ffffff" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Uso",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Cocina" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Ideal para cocina" },
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "text", "id": "imagen_defecto", "label": "Archivo por defecto", "default": "mt-uso-cocina.jpg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Uso en casa",
      "blocks": [
        { "type": "punto", "settings": { "titulo": "Cocina", "texto": "Fregaderos y encimeras sin restos de grasa", "imagen_defecto": "mt-uso-cocina.jpg" } },
        { "type": "punto", "settings": { "titulo": "Baño", "texto": "Azulejos y juntas de baño, sin agacharte", "imagen_defecto": "cp-step-bano.jpg" } },
        { "type": "punto", "settings": { "titulo": "Auto", "texto": "Llantas y tapicería del coche", "imagen_defecto": "cp-step-auto.jpg" } },
        { "type": "punto", "settings": { "titulo": "Superficies", "texto": "Un solo cepillo para cada rincón", "imagen_defecto": "mt-detalle-kit.jpg" } }
      ]
    }
  ]
}
{% endschema %}
