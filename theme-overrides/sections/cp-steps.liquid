<section class="cp-steps" id="cp-steps-{{ section.id }}">
  <header class="cp-head">
    {%- if section.settings.kicker != blank -%}
      <p class="cp-kicker cp-kicker--ink">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="cp-head__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </header>
  <div class="cp-steps__grid">
    {%- for block in section.blocks -%}
      {%- assign fallback = 'cp-step-bano.jpg' -%}
      {%- if forloop.index == 2 -%}{%- assign fallback = 'cp-step-cocina.jpg' -%}{%- endif -%}
      {%- if forloop.index == 3 -%}{%- assign fallback = 'cp-step-auto.jpg' -%}{%- endif -%}
      <article class="cp-card" {{ block.shopify_attributes }} style="--d: {{ forloop.index0 | times: 90 }}ms;">
        <div class="cp-card__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'cp-card__photo', loading: 'lazy', alt: block.settings.title }}
          {%- else -%}
            <img class="cp-card__photo" src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" width="1024" height="1024" loading="lazy">
          {%- endif -%}
          <span class="cp-card__index">0{{ forloop.index }}</span>
        </div>
        <div class="cp-card__copy">
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.cp-steps {
  max-width: 1240px;
  margin: 0 auto;
  padding: 28px 16px 8px;
}
.cp-head { margin-bottom: 22px; }
.cp-kicker--ink { color: #1d6fe8; }
.cp-head__title {
  margin: 6px 0 0;
  font-size: clamp(1.5rem, 2.6vw, 2.2rem);
  letter-spacing: -0.03em;
  color: #0b1f33;
}
.cp-steps__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.cp-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  animation: cp-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--d, 0ms);
}
.cp-card__media {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  background: #eaf3fb;
}
.cp-card__photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 70% 50%;
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}
.cp-card:hover .cp-card__photo { transform: scale(1.06); }
.cp-card__index {
  position: absolute;
  top: 14px;
  left: 14px;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.86);
  color: #1d6fe8;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  backdrop-filter: blur(10px);
}
.cp-card__copy h3 {
  margin: 0;
  font-size: 1.15rem;
  color: #0b1f33;
}
.cp-card__copy p {
  margin: 6px 0 0;
  color: #46607a;
  line-height: 1.45;
  font-size: 0.95rem;
}
@media (max-width: 749px) {
  .cp-steps__grid { grid-template-columns: 1fr; }
  .cp-card__media { aspect-ratio: 16 / 10; }
}
@media (prefers-reduced-motion: reduce) {
  .cp-card, .cp-card__photo { animation: none; transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "CP Pasos",
  "tag": "section",
  "class": "cp-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Así funciona" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Tres gestos. Casa impecable." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto del paso (sin texto)" },
        { "type": "text", "id": "title", "label": "Titulo", "default": "Paso" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CP Pasos",
      "category": "CleanPro",
      "blocks": [
        { "type": "step", "settings": { "title": "Baño", "text": "Azulejos, grifería y juntas sin restregar." } },
        { "type": "step", "settings": { "title": "Cocina", "text": "Grasa y encimeras, con el cabezal justo." } },
        { "type": "step", "settings": { "title": "Auto", "text": "Rincones de llantas y molduras al detalle." } }
      ]
    }
  ]
}
{% endschema %}
